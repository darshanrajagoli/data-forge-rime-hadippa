# Waypoint - copy to .env.local and fill in. NEVER commit .env.local.
#
#   cp .env.example .env.local
#   python scripts/preflight.py
#
# Every value below is a placeholder. scripts/secret_scan.py treats this file
# as a template and will not flag it, but it WILL flag a real key anywhere else.

# ---------------------------------------------------------------- required --
# LiveKit Cloud project: https://cloud.livekit.io  (free tier is enough)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Rime: https://app.rime.ai/signup  - this is the primary spoken output
RIME_API_KEY=your-rime-api-key

# LiveKit Inference covers STT and LLM with the keys above. If you would
# rather bring your own provider, set the matching key and change WAYPOINT_STT
# / WAYPOINT_LLM below.
# OPENAI_API_KEY=your-openai-api-key
# DEEPGRAM_API_KEY=your-deepgram-api-key

# ------------------------------------------------------------------- Rime --
# Model: coda | mistv2 | mistv3.  Check the live catalog before the demo:
#   https://docs.rime.ai/api-reference/voices
# coda is Rime's newest and most expressive, and is what their LiveKit
# quickstart recommends. It IGNORES bracket controls, so pronunciation uses
# respelling. mistv2 honours {phonemes} and <pauses>.
RIME_MODEL=coda
RIME_SPEAKER=lyra
RIME_LANG=eng
RIME_SAMPLE_RATE=22050
RIME_SPEED_ALPHA=1.0

# WebSocket carries word-level timestamps, which is what makes heard-not-said
# exact rather than estimated. Turning this off is disclosed at startup.
RIME_USE_WEBSOCKET=true
RIME_SEGMENT=bySentence
# RIME_BASE_URL=

# ---------------------------------------------------------- pronunciation --
# respell  - portable, works on every model (default)
# phoneme  - exact, mistv2 only; startup FAILS if paired with coda
# none     - the "before" arm of the pronunciation experiment
WAYPOINT_PRONUNCIATION=respell
# Pause brackets, mistv2 only. Ignored (and reported) on coda.
WAYPOINT_PAUSE_MS=0

# ----------------------------------------------------------------- models --
WAYPOINT_STT=deepgram/nova-3
WAYPOINT_STT_LANGUAGE=multi
WAYPOINT_LLM=openai/gpt-4.1-mini

# --------------------------------------------------------- turn behaviour --
# adaptive uses LiveKit's barge-in classifier; vad is the simpler fallback.
WAYPOINT_INTERRUPTION_MODE=adaptive
WAYPOINT_MIN_INTERRUPTION_DURATION=0.4
WAYPOINT_MIN_INTERRUPTION_WORDS=0
WAYPOINT_RESUME_FALSE_INTERRUPTION=true
WAYPOINT_FALSE_INTERRUPTION_TIMEOUT=1.0
WAYPOINT_PREEMPTIVE_GENERATION=true

# ------------------------------------------------------------------- demo --
# Dispatch lookups are deliberately slow so the barge-in race is visible on
# camera. Drop to 300 for a snappier feel, 0 for tests.
WAYPOINT_DISPATCH_LATENCY_MS=1800
WAYPOINT_DISPATCH_JITTER_MS=200
WAYPOINT_PUBLISH_FENCE_EVENTS=true
